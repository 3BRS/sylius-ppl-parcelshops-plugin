{# @var \ThreeBRS\SyliusPplParcelshopsPlugin\Model\PplShipmentInterface shipment #}
{% set shipment = hookable_metadata.context.order.shipments.last %}

{% if shipment and shipment.hasPplPickupPoint() %}
    {% set ppl_data = shipment.pplData %}

    <address class="d-flex flex-column">
        <span>{{ 'threebrs.shop.checkout.complete.pplParcelShop'|trans }}</span>
        {% if ppl_data %}
            <strong>{{ ppl_data.name|default('') }}</strong>
            {% if ppl_data.parcelshopName is defined and ppl_data.parcelshopName %}
                <span>{{ ppl_data.parcelshopName }}</span>
            {% endif %}
            {% if ppl_data.street is defined and ppl_data.street %}
                <span>{{ ppl_data.street }}</span>
            {% endif %}
            {% set city_and_zip_code = [ppl_data.city ?? null, ppl_data.zipCode ?? null]|filter(value => value) %}
            {% if city_and_zip_code is not empty %}
                <span>{{ city_and_zip_code|join(', ') }}</span>
            {% endif %}
            {% if ppl_data.country is defined and ppl_data.country %}
                <span>{{ ppl_data.country|upper|sylius_country_name|upper }}</span>
            {% endif %}
        {% else %}
            <strong>{{ shipment.pplKTMname }}</strong>
            <span>{{ shipment.pplKTMaddress }}</span>
        {% endif %}
    </address>
{% else %}
    {% include '@SyliusShop/shared/address.html.twig' %}
{% endif %}
