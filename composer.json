	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": false,
			"rector/extension-installer": true,
			"symfony/flex": false
		},
		"audit": {
			"ignore": [
				"PKSA-gs8r-6kz6-pp56",
				"PKSA-gnn4-pxdg-q76m",
				"PKSA-4g5g-4rkv-myqs"
